# Local Terraform directories
**/.terraform/*

# State files
*.tfstate
*.tfstate.*

# Plan files
*.tfplan

# Examples are kept local only
examples/

# Crash logs
crash.log
crash.*.log

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Lock file: not committed in a module repo, the caller pins provider versions
.terraform.lock.hcl

# Variable files may contain real values (example tfvars are allowed)
*.tfvars
*.tfvars.json
!examples/**/*.tfvars

# CI tools downloaded locally
.tools/

# Generated release notes
release-notes.md

# Generated azurerm review report
azurerm-report.md

# Generated by the azurerm check and upgrade agent
azurerm-release-notes.md
azurerm-affected.json
agent-patch.diff
pr-body.md
verify-baseline.txt
verify-final.txt

# Python
__pycache__/
.pytest_cache/
.venv/
